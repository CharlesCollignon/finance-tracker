# Supabase — same project as the web app (Dashboard → Project Settings → API).
# Public client values only. Never put the service_role key in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The web app's origin. Optional, and the route to anything that needs a
# server-side secret: asking the bank for new movements (the open-banking
# credentials live on the web server) and writing a month read (the Mistral
# key does too). Without this the app still works — a refresh re-reads
# Supabase and the read card shows whatever was last written; only the two
# buttons that need the server are unavailable.
EXPO_PUBLIC_WEB_APP_URL=https://pluclair.com
