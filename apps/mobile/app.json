{
  "expo": {
    "name": "Pluclair",
    "slug": "pluclair",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pluclair",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a10",
    "ios": {
      "bundleIdentifier": "com.salutcharles.pluclair",
      "associatedDomains": [
        "webcredentials:pluclair.com"
      ],
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "NSFaceIDUsageDescription": "Pluclair utilise Face ID pour déverrouiller l'application."
      }
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json"
    },
    "android": {
      "package": "com.salut_charles.pluclair",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pluclair utilise Face ID pour déverrouiller l'application."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ecb25e",
          "defaultChannel": "reminders"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      "./plugins/with-quick-actions",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Figure",
              "label": "Il vous reste",
              "description": "Ce qu'il vous reste jusqu'à votre prochain revenu, et un « + » pour noter une dépense.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a67d969-c45e-4075-b372-9a14d9fed237"
      }
    },
    "owner": "salutcharless-team"
  }
}
