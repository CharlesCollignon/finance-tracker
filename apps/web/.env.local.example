# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for "Delete account" (never expose to the browser)
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL for auth redirects (production: https://pluclair.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth credentials go in Supabase Dashboard only:
# Authentication → Providers → Google

# Passkeys (native) — hosted at /.well-known on pluclair.com
# Apple Team ID (Membership details in Apple Developer)
APPLE_TEAM_ID=
# Comma-separated SHA-256 cert fingerprints, colon-hex
# (eas credentials → Android keystore). Example:
# AA:BB:CC:...:FF,11:22:...
ANDROID_SHA256_FINGERPRINTS=

# Web push notifications (optional).
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key ships to the browser; the private key must stay server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push service should contact about your sends. mailto: or https URL.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the daily cron jobs (repricing and notifications). Vercel
# sends it as `Authorization: Bearer <CRON_SECRET>`; without it the routes
# refuse to run. Repricing also needs SUPABASE_SERVICE_ROLE_KEY above.
CRON_SECRET=

# Bank feed (optional) — open-banking.io, single-user path.
# In the open-banking.io app: connect a bank, create an API key, then
# "Exporter credentials.json". Paste that whole file here as one line — it is
# handed to the SDK verbatim, so whatever fields it contains are fine.
# This bundle is a DECRYPTION KEY for your bank data. Server-side only —
# never expose it to a browser, and never commit it.
OPEN_BANKING_CREDENTIALS=
# Which user the bundle belongs to. Without it the feed would answer for
# whoever asked, which on a multi-account deployment would hand one person
# another's bank data.
OPEN_BANKING_OWNER_USER_ID=

# Bank connect (optional) — every user brings their own open-banking.io
# account and uploads its credentials file on /bank. The key below seals each
# file before it is stored; without it nobody is offered setup. Who is offered
# it is then the `bank.connect` feature flag (migration 042), off by default.
# Seals each user's bank keys before they are stored (AES-256-GCM). 32 random
# bytes, base64: `openssl rand -base64 32`. Losing it means every user has to
# connect again, so keep it with your other secrets. To rotate, move the old
# value to BANK_SECRETS_KEY_PREVIOUS and set a new one; rows sealed with the
# old key still open.
BANK_SECRETS_KEY=
BANK_SECRETS_KEY_PREVIOUS=

# Seals each user's AI account key — the one OpenRouter creates for them when
# they connect — and the PKCE verifier of a connection in progress
# (AES-256-GCM, docs/plans/AI_ACCOUNT_PLAN.md). Its own key, never the
# bank's: `openssl rand -base64 32`. Losing it means every user has to
# connect their AI account again. Rotate as above, through
# AI_SECRETS_KEY_PREVIOUS.
AI_SECRETS_KEY=
AI_SECRETS_KEY_PREVIOUS=

# Every read and every question is written on the user's own AI account,
# connected from Profile through OpenRouter and paid by them: Pluclair holds
# no model key of its own. AI_SECRETS_KEY above is all the server needs for
# it; without it, no AI account can be connected and nothing is written.
#
# The model writes prose and never a figure: it refers to the app's own
# numbers by name and the app substitutes them, so nothing it invents can
# reach the screen. Aggregates go over the wire — category totals, the
# reconciliation figures, and for the month in progress the total the
# day-to-day accounts hold — never merchants or individual payments.
#
# Reading an instrument for the look-through uses OpenRouter's web search
# on the same account, at most once per instrument held, refreshed about
# twice a year. The geography and sector sections are the only ones that
# need it — overlap by index, weighted charges, wrapper eligibility and the
# target allocation are the app's own arithmetic and need no model at all.

# The phone app's pages in the stores, once it is published
# (docs/store/README.md). Unset, the landing keeps « L'application mobile »
# under « Bientôt »; set either one and the landing shows a « Sur votre
# téléphone » section with the link. Only an https://apps.apple.com/… and an
# https://play.google.com/… address are taken.
APP_STORE_URL=
PLAY_STORE_URL=

# Where « Envoyer un retour » in Profile writes to. Optional: without it the
# row is not shown. The phone reads its own, EXPO_PUBLIC_FEEDBACK_EMAIL.
FEEDBACK_EMAIL=
