# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for "Delete account" (never expose to the browser)
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL for auth redirects (production: https://pluclair.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth credentials go in Supabase Dashboard only:
# Authentication → Providers → Google

# Passkeys (native) — hosted at /.well-known on pluclair.com
# Apple Team ID (Membership details in Apple Developer)
APPLE_TEAM_ID=
# Comma-separated SHA-256 cert fingerprints, colon-hex
# (eas credentials → Android keystore). Example:
# AA:BB:CC:...:FF,11:22:...
ANDROID_SHA256_FINGERPRINTS=

# Web push notifications (optional).
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key ships to the browser; the private key must stay server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push service should contact about your sends. mailto: or https URL.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the daily cron jobs (repricing and notifications). Vercel
# sends it as `Authorization: Bearer <CRON_SECRET>`; without it the routes
# refuse to run. Repricing also needs SUPABASE_SERVICE_ROLE_KEY above.
CRON_SECRET=

# Bank feed (optional) — open-banking.io, single-user path.
# In the open-banking.io app: connect a bank, create an API key, then
# "Exporter credentials.json". Paste that whole file here as one line — it is
# handed to the SDK verbatim, so whatever fields it contains are fine.
# This bundle is a DECRYPTION KEY for your bank data. Server-side only —
# never expose it to a browser, and never commit it.
OPEN_BANKING_CREDENTIALS=
# Which user the bundle belongs to. Without it the feed would answer for
# whoever asked, which on a multi-account deployment would hand one person
# another's bank data.
OPEN_BANKING_OWNER_USER_ID=
