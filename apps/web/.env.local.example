# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for "Delete account" (never expose to the browser)
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL for auth redirects (production: https://pluclair.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth credentials go in Supabase Dashboard only:
# Authentication → Providers → Google

# Passkeys (native) — hosted at /.well-known on pluclair.com
# Apple Team ID (Membership details in Apple Developer)
APPLE_TEAM_ID=
# Comma-separated SHA-256 cert fingerprints, colon-hex
# (eas credentials → Android keystore). Example:
# AA:BB:CC:...:FF,11:22:...
ANDROID_SHA256_FINGERPRINTS=

# Web push notifications (optional).
# Generate a pair once with:  npx web-push generate-vapid-keys
# The public key ships to the browser; the private key must stay server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the push service should contact about your sends. mailto: or https URL.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the daily cron jobs (repricing and notifications). Vercel
# sends it as `Authorization: Bearer <CRON_SECRET>`; without it the routes
# refuse to run. Repricing also needs SUPABASE_SERVICE_ROLE_KEY above.
CRON_SECRET=

# Bank feed (optional) — open-banking.io, single-user path.
# In the open-banking.io app: connect a bank, create an API key, then
# "Exporter credentials.json". Paste that whole file here as one line — it is
# handed to the SDK verbatim, so whatever fields it contains are fine.
# This bundle is a DECRYPTION KEY for your bank data. Server-side only —
# never expose it to a browser, and never commit it.
OPEN_BANKING_CREDENTIALS=
# Which user the bundle belongs to. Without it the feed would answer for
# whoever asked, which on a multi-account deployment would hand one person
# another's bank data.
OPEN_BANKING_OWNER_USER_ID=

# The month read (optional) — a short written analysis of a month, on the
# Month page. Without this the card simply does not appear.
#
# The model writes prose and never a figure: it refers to the app's own
# numbers by name and the app substitutes them, so nothing it invents can
# reach the screen. Aggregates go over the wire — category totals, the
# reconciliation figures — never merchants, individual payments or balances.
#
# This key is server-side only. Never expose it to a browser, never log it,
# and never return it from an action. Switch on the training opt-out in
# Mistral's console before using it in earnest.
MISTRAL_API_KEY=
# Optional. Defaults to mistral-medium-latest. At five reads a month the bill
# is a few cents either way, so this is chosen on quality alone.
#
# Mistral's free plan entitles a key to the open-weight ministral models only;
# small and medium answer 429 and large answers 403 with "not available in
# your subscription tier". Adding a card is not enough on its own — the
# workspace itself has to be moved off the free plan in the console, and the
# 403 message is how you tell whether that has taken effect.
#
# On a free key, set this to ministral-14b-latest, the largest of them. It
# works, but it is visibly weaker at the thing this prompt asks that is hard:
# naming the category beside a figure rather than letting the figure stand in
# for the name. If the reads read badly, this line is the first thing to look
# at, and the server log says which model actually answered.
MISTRAL_MODEL=
